<odoo>
    <record id="estate_form" model="ir.ui.view">
        <field name="name">Estate Form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name"/>
                        </h1>
                    </div>

                    <!-- Main info -->
                    <group>
                        <group class="oe_inline">
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>

                        <group class="oe_inline">
                            <field name="expected_price"/>
                            <field name="selling_price" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Description tab -->
                        <page string="Description">
                               
                            <group>
                                <field name="description" placeholder="Describe the property..."/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="state"/>
                            </group>
                                
                        </page>
                    </notebook>

                </sheet>
            </form>

        </field>
    </record>
</odoo>