<odoo>

<!--action view-->
  <record id="property_type_action" model="ir.actions.act_window">
      <field name="name">Property Types</field>
      <field name="res_model">estate.property.type</field>
      <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Define a new Property Type
        </p>
      </field>
  </record>

<!--Form View-->

<record id="estate_type_form" model="ir.ui.view">
      <field name="name">Estate Type Form</field>
      <field name="model">estate.property.type</field>
      <field name="arch" type="xml">
          <form string="Estate Property Type">
            <header>
              <button type="action"
                name="%(property_offer_action)d"
                class="oe_stat_button"
                icon="fa-tags"
                title="Offers">
                <field name="offer_count" widget="statinfo"/>
              </button>
            </header>
            
            <sheet>
              <!-- Title -->
              <group>
                  <h1>
                      <field name="name" placeholder="Property Type"/>
                  </h1>
                  
              </group>
            
              <notebook>
                <page string="Properties">
                  <field name="property_id">
                    <list>
                      <field name="name"/>
                      <field name="expected_price"/>
                      <field name="state"/>
                    </list>
                  </field>
                </page>
              </notebook>
            </sheet>
          </form>
      </field>
</record>

<!-- list view-->

<record id="type_list_view" model="ir.ui.view">
    <field name="name">Type List</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
        <list>
          <field name="sequence" widget="handle"/>
          <field name="name"/>  
          <field name="offer_count"/>
        </list>
    </field>
</record>

</odoo>