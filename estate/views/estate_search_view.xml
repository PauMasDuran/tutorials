<odoo>
    <record id="view_estate_search" model="ir.ui.view">
        <field name="name">estate_search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Tests">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="New" name="new_estate" domain="[('state', '=', 'New')]"/>
                <filter string="Offer recieved" name="offered_estate" domain="[('state', '=', 'Offer Received')]"/>
                <!--<group expand="1" string="Group By">
                    <filter string="Postcode" name="postcode_group" context="{'group_by':'postcode', 'residual_visible':True}"/>
                </group>-->
            </search>
        </field>
    </record>
</odoo>