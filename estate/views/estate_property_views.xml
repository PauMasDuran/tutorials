

<odoo>

<!--action view-->
  <record id="test_model_action" model="ir.actions.act_window">
      <field name="name">Properties</field>
      <field name="res_model">estate.property</field>
      <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Define a new Advertisement
        </p>
      </field>
  </record>

<!-- Form view-->

    <record id="estate_form" model="ir.ui.view">
        <field name="name">Estate Form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">

                <header>
                        <button name="sell_property" type="object" string="Sold"/>
                        <button name="cancel_property" type="object" string="Cancel"/>
                </header>

                <sheet>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name"/>
                        </h1>
                        <field name="tag_id" widget="many2many_tags"/>
                        
                    </div>
                    <!-- Main info -->
                    <group>
                        <div class="row">
                            <div class="col-3">
                                
                                <group>
                                    <field name="property_type_id"/>
                                    <field name="postcode"/>
                                    <field name="date_availability"/>
                                </group>
                            </div>
                            <div class="col-3">
                                <group>
                                    <field name="expected_price"/>
                                    <field name="best_offer" readonly="1" />
                                    <field name="selling_price" readonly="1" />
                                </group>
                            </div>
                        </div>   
                    </group>

                    <notebook>

                        <!-- Description tab -->
                        <page string="Description">
                                
                            <group>
                                <field name="description" placeholder="Describe the property..."/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="state"/>
                                <field name="total_area"/>
                            </group>
                                
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity" />
                                    <field name="date_deadline"/>
                                    <button name="confirm_status" states="draft" type="object" title="Accepted" icon="fa-check"/>
                                    <button name="refused_status" states="draft" type="object" title="Refused" icon="fa-times"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>

        </field>
    </record>

<!--List view-->

  <record id="estate_list_view_tree" model="ir.ui.view">
  <field name="name">Estate List</field>
  <field name="model">estate.property</field>
  <field name="arch" type="xml">
      <list string="Tests">
          <field name="name"/>
          <field name="postcode"/>
          <field name="bedrooms"/>
          <field name="living_area"/>
          <field name="expected_price"/>
          <field name="selling_price"/>
          <field name="date_availability"/>
      </list>
  </field>
</record>

<!--Search view-->

<record id="view_estate_search" model="ir.ui.view">
    <field name="name">estate_search</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
        <search string="Tests">
            <field name="name"/>
            <field name="postcode"/>
            <field name="bedrooms"/>
            <field name="living_area"/>
            <field name="expected_price"/>
            <field name="selling_price"/>
            <field name="date_availability"/>
            <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            <filter string="New" name="new_estate" domain="[('state', '=', 'new')]"/>
            <filter string="Offer recieved" name="offered_estate" domain="[('state', '=', 'offer Received')]"/>
            <!--<group expand="1" string="Group By">-->
            <filter string="Postcode" name="postcode_group" context="{'group_by':'postcode'}"/>
            <!--</group>-->
        </search>
    </field>
</record>

</odoo>